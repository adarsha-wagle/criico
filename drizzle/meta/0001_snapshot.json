        "matches_distinct_teams": {
          "name": "matches_distinct_teams",
          "value": "\"matches\".\"team_a_id\" <> \"matches\".\"team_b_id\""
        },
        "matches_valid_winner": {
          "name": "matches_valid_winner",
          "value": "\n        \"matches\".\"winner_team_id\" IS NULL\n        OR \"matches\".\"winner_team_id\" IN (\"matches\".\"team_a_id\", \"matches\".\"team_b_id\")\n      "
        },
        "matches_valid_result": {
          "name": "matches_valid_result",
          "value": "\n        (\n          \"matches\".\"status\" IN ('scheduled', 'in_progress')\n          AND \"matches\".\"winner_team_id\" IS NULL\n        )\n        OR\n        (\n          \"matches\".\"status\" = 'completed'\n          AND \"matches\".\"winner_team_id\" IS NOT NULL\n        )\n        OR\n        (\n          \"matches\".\"status\" = 'draw'\n          AND \"matches\".\"winner_team_id\" IS NULL\n        )\n      "
        }
      },
